# Copy to .env and fill in real values. .env is gitignored; this file is committed.
#
#   cp .env.example .env
#
# The YAML config references these as ${VAR} / ${VAR:-default}, so no credential ever
# lives inside config/config.local.yaml. Variables you export yourself always win over
# this file, so CI secrets and one-off overrides still work.

# Hugging Face access token for pyannote/speaker-diarization-community-1.
# Create it at https://huggingface.co/settings/tokens and accept that model's
# shared-access conditions first, or diarization fails with a gating error.
HF_TOKEN=

# OpenAI-compatible endpoint used by the translation stage (LiteLLM, vLLM, ...).
# List what a server offers with:  curl -H "Authorization: Bearer $KEY" $BASE/models
LITELLM_BASE_URL=https://litellm.example.com/v1
LITELLM_API_KEY=sk-example-not-a-real-key
LITELLM_MODEL=chat
