# Local Pi runtime state
.atl/

# Local configuration may carry credentials
config/config.local.yaml

# Python
__pycache__/
*.py[cod]
.venv/
*.egg-info/
build/
dist/
.pytest_cache/
.coverage
htmlcov/

# uv environments keep their lockfiles, never their virtualenvs
environments/*/.venv/

# Pipeline outputs are data, not source
/output/

# Tool scratch
.pytest-tmp/

# Model checkpoints are downloaded on first use and are data, not source. Ultralytics'
# own `weights_dir` is a RELATIVE path held in a user-level settings file, so with
# persons.weights_dir unset the worker's checkpoint lands in whatever directory started
# the process -- the repository root for a normal `multimodal-pipeline run`. Set
# persons.weights_dir to keep it somewhere deliberate instead (see config/config.example.yaml).
*.pt

# OS
.DS_Store

# Input media is data, not source, and most of it is not ours to redistribute:
# real broadcast clips, third-party example media, and anything a teammate drops in
# to test. Everything in here is ignored except the three fixtures that
# scripts/make_fixtures.sh generates, which are committed so a fresh clone can run
# the pipeline and the tests without a camera.
# (person_demo.avi comes from a local OpenPose install and is copied on demand by
# that same script -- it stays ignored.)
data/input_videos/*
!data/input_videos/pipeline_demo.mp4
!data/input_videos/pipeline_demo_ntsc.mov
!data/input_videos/pipeline_silent.mp4

# Processed datasets are reproducible outputs, not source: a pose dataset for one
# short clip is tens of megabytes and every file is regenerable from the fixtures.
# Regenerate with `multimodal-pipeline run` after `scripts/make_fixtures.sh`.
data/processed/

# Credentials. Never committed: this file is copied between machines, pasted into
# issues and committed by accident far more often than a dedicated secret file is.
# .env.example (fake values) is committed as the template.
.env
.env.*
!.env.example

# Local scratch for the pi harness. `modes.config.json` is the project's autonomy
# policy and IS versioned; settings/extensions/prompts under .pi are per-machine and
# would make every clone ask for project trust.
.pi/*
!.pi/modes.config.json
